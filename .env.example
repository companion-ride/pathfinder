# Main
PORT=8080
APP_ENV=local
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=companion_db
DB_USERNAME=companion_user
DB_PASSWORD=companion_password
DB_SCHEMA=public

# 2GIS API keys (comma-separated). pathfinder rotates across these on HTTP 429;
# each key is cooled down per its Retry-After response header.
DOUBLE_GIS_API_KEYS=

# Legacy single-key var. Used as a fallback only when DOUBLE_GIS_API_KEYS is unset.
# DOUBLE_GIS_API_KEY=

# API Gateway registration
GATEWAY_URL=http://<gateway-vps-ip>:9090
GATEWAY_SECRET=changeme
SERVICE_HOST=<this-vps-ip>

# JWT
JWT_SECRET_KEY=your-jwt-secret

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# 2GIS Routing API
# DOUBLEGIS_BASE_URL=http://routing.api.2gis.com/routing/7.0.0/global
# DOUBLEGIS_LOCALE=kk

# Config Service (optional — falls back to hardcoded defaults)
CONFIG_SERVICE_URL=http://localhost:8082
CONFIG_SERVICE_API_KEY=

# Swagger UI (set in production to reflect gateway prefix)
# SWAGGER_HOST=companion.kopir.uk
# SWAGGER_BASE_PATH=/api/pathfinder

# Debug page (/app) and /config; keep disabled in production
# ENABLE_DEBUG_PAGES=true
