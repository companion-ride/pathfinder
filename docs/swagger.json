    "definitions": {
        "geo.Coord": {
            "type": "object",
            "properties": {
                "lat": {
                    "type": "number"
                },
                "lon": {
                    "type": "number"
                }
            }
        },
        "geo.Segment": {
            "type": "object",
            "properties": {
                "color": {
                    "type": "string"
                },
                "comment": {
                    "type": "string"
                },
                "coords": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/geo.Coord"
                    }
                },
                "distance": {
                    "type": "integer"
                },
                "duration": {
                    "type": "integer"
                },
                "street_names": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "server.CreateCustomRouteRequest": {
            "type": "object",
            "required": [
                "segments"
            ],
            "properties": {
                "segments": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/server.CustomRouteSegment"
                    }
                }
            }
        },
        "server.CreateRouteRequest": {
            "type": "object",
            "required": [
                "point_a",
                "point_b"
            ],
            "properties": {
                "point_a": {
                    "$ref": "#/definitions/server.PointInput"
                },
                "point_b": {
                    "$ref": "#/definitions/server.PointInput"
                }
            }
        },
        "server.CreateRouteResponse": {
            "type": "object",
            "properties": {
                "route_id": {
                    "type": "string"
                },
                "segments": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/geo.Segment"
                    }
                },
                "total_distance": {
                    "type": "string"
                },
                "total_duration": {
                    "type": "string"
                }
            }
        },
        "server.CustomRouteCoord": {
            "type": "object",
            "properties": {
                "lat": {
                    "type": "number",
                    "maximum": 90,
                    "minimum": -90
                },
                "lon": {
                    "type": "number",
                    "maximum": 180,
                    "minimum": -180
                }
            }
        },
        "server.CustomRouteSegment": {
            "type": "object",
            "required": [
                "coords"
            ],
            "properties": {
                "coords": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                        "$ref": "#/definitions/server.CustomRouteCoord"
                    }
                }
            }
        },
        "server.FindClosestPointRequest": {
            "type": "object",
            "required": [
                "lat",
                "lon"
            ],
            "properties": {
                "lat": {
                    "type": "number",
                    "maximum": 90,
                    "minimum": -90
                },
                "lon": {
                    "type": "number",
                    "maximum": 180,
                    "minimum": -180
                }
            }
        },
        "server.FindClosestPointResponse": {
            "type": "object",
            "properties": {
                "closest_lat": {
                    "type": "number"
                },
                "closest_lon": {
                    "type": "number"
                },
                "passenger_lat": {
                    "type": "number"
                },
                "passenger_lon": {
                    "type": "number"
                }
            }
        },
        "server.PointInput": {
            "type": "object",
            "required": [
                "lat",
                "lon"
            ],
            "properties": {
                "lat": {
                    "type": "number",
                    "maximum": 90,
                    "minimum": -90
                },
                "lon": {
                    "type": "number",
                    "maximum": 180,
                    "minimum": -180
                }
            }
        },
        "server.WalkToClosestResponse": {
            "type": "object",
            "properties": {
                "closest_lat": {
                    "type": "number"
                },
                "closest_lon": {
                    "type": "number"
                },
                "geometry": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/geo.Coord"
                    }
                },
                "passenger_lat": {
                    "type": "number"
                },
                "passenger_lon": {
                    "type": "number"
                },
                "raw_walk_response": {
                    "type": "object"
                },
                "walk_distance": {
                    "type": "string"
                },
                "walk_duration": {
                    "type": "string"
                }
            }
