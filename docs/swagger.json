{
    "swagger": "2.0",
    "info": {
        "description": "GIS routing service — builds driving routes via 2GIS and computes walking paths from a passenger to the nearest point on a route.",
        "title": "Pathfinder API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
